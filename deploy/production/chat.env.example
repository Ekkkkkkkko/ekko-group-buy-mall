SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8095
JAVA_OPTS=-Xms256m -Xmx640m -Xss512k -XX:+UseG1GC -XX:MaxGCPauseMillis=250 -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/app/data/log -XX:+ExitOnOutOfMemoryError

SPRING_DATASOURCE_URL=jdbc:mysql://__RDS_HOST__:3306/group_buy_chat?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&sslMode=__RDS_SSL_MODE__&connectTimeout=5000&socketTimeout=30000&tcpKeepAlive=true
SPRING_DATASOURCE_USERNAME=group_buy_chat
SPRING_DATASOURCE_PASSWORD=__RDS_PASSWORD__
CHAT_DB_MINIMUM_IDLE=1
CHAT_DB_MAXIMUM_POOL_SIZE=6
CHAT_DB_CONNECTION_TIMEOUT_MS=5000
CHAT_DB_IDLE_TIMEOUT_MS=600000
CHAT_DB_KEEPALIVE_TIME_MS=300000
CHAT_DB_MAX_LIFETIME_MS=1500000

CHAT_REDIS_HOST=redis
CHAT_REDIS_PORT=6379
CHAT_REDIS_PASSWORD=__REDIS_PASSWORD__
