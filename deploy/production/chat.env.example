CHAT_REDISSON_ADDRESS=redis://redis:6379
CHAT_ALLOWED_ORIGINS=http://__PUBLIC_HOST__,http://ekkoliu.com,http://www.ekkoliu.com,https://ekkoliu.com,https://www.ekkoliu.com

OSS_REGION=cn-shanghai
