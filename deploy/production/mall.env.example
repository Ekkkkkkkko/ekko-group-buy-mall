SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8092
JAVA_OPTS=-Xms256m -Xmx512m -Xss512k -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/app/data/log -XX:+ExitOnOutOfMemoryError -Xlog:gc*:file=/app/data/log/gc.log:time,uptime,level,tags:filecount=3,filesize=10M

SERVER_TOMCAT_THREADS_MAX=60
SERVER_TOMCAT_THREADS_MIN_SPARE=5
SERVER_TOMCAT_MAX_CONNECTIONS=500
SERVER_TOMCAT_ACCEPT_COUNT=50
SERVER_TOMCAT_CONNECTION_TIMEOUT=10s

SPRING_DATASOURCE_URL=jdbc:mysql://__RDS_HOST__:3306/group_buy_mall?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&sslMode=__RDS_SSL_MODE__&connectTimeout=5000&socketTimeout=30000&tcpKeepAlive=true
SPRING_DATASOURCE_USERNAME=group_buy_mall
SPRING_DATASOURCE_PASSWORD=__RDS_PASSWORD__
MALL_DB_MINIMUM_IDLE=2
MALL_DB_MAXIMUM_POOL_SIZE=8
MALL_DB_CONNECTION_TIMEOUT_MS=5000
MALL_DB_VALIDATION_TIMEOUT_MS=3000
MALL_DB_IDLE_TIMEOUT_MS=600000
MALL_DB_KEEPALIVE_TIME_MS=300000
MALL_DB_MAX_LIFETIME_MS=1500000

SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=ekko_app
SPRING_RABBITMQ_PASSWORD=__RABBITMQ_PASSWORD__
SPRING_RABBITMQ_VIRTUAL_HOST=/
RABBITMQ_LISTENER_CONCURRENCY=1
RABBITMQ_LISTENER_MAX_CONCURRENCY=2
RABBITMQ_REFUND_PREFETCH=1

BUSINESS_EXECUTOR_CORE_POOL_SIZE=2
BUSINESS_EXECUTOR_MAX_POOL_SIZE=4
BUSINESS_EXECUTOR_KEEP_ALIVE_SECONDS=60
BUSINESS_EXECUTOR_QUEUE_CAPACITY=100
BUSINESS_EXECUTOR_REJECTION_POLICY=CallerRunsPolicy

MALL_REDIS_HOST=redis
MALL_REDIS_PORT=6379
MALL_REDIS_PASSWORD=__REDIS_PASSWORD__
MALL_REDIS_POOL_SIZE=6
MALL_REDIS_MIN_IDLE_SIZE=1

AUTH_JWT_SECRET=__JWT_SECRET__
GROUP_BUY_MARKET_API_URL=http://market:8091/
GROUP_BUY_MARKET_SOURCE=s01
GROUP_BUY_MARKET_CHANNEL=c01
GROUP_BUY_MARKET_NOTIFY_TYPE=HTTP
GROUP_BUY_MARKET_NOTIFY_URL=http://mall:8092/api/v1/alipay/group_buy_notify
GROUP_BUY_MARKET_NOTIFY_MQ=
GROUP_BUY_NOTIFY_TOKEN=__NOTIFY_TOKEN__

ALIPAY_ENABLED=false
ALIPAY_APP_ID=
ALIPAY_MERCHANT_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=http://__PUBLIC_HOST__/mall-api/api/v1/alipay/pay_notify
ALIPAY_RETURN_URL=http://__PUBLIC_HOST__/
# 沙箱联调时改为 https://openapi-sandbox.dl.alipaydev.com/gateway.do；正式环境保留下方地址。
ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do

WEIXIN_CALLBACK_TOKEN=
WEIXIN_ORIGINAL_ID=
WEIXIN_APP_ID=
WEIXIN_APP_SECRET=
WEIXIN_TEMPLATE_ID=
LOG_LEVEL_ROOT=info
