SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8091
JAVA_OPTS=-Xms256m -Xmx512m -Xss512k -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/app/data/log -XX:+ExitOnOutOfMemoryError -Xlog:gc*:file=/app/data/log/gc.log:time,uptime,level,tags:filecount=3,filesize=10M

SERVER_TOMCAT_THREADS_MAX=60
SERVER_TOMCAT_THREADS_MIN_SPARE=5
SERVER_TOMCAT_MAX_CONNECTIONS=500
SERVER_TOMCAT_ACCEPT_COUNT=50
SERVER_TOMCAT_CONNECTION_TIMEOUT=10s

SPRING_DATASOURCE_URL=jdbc:mysql://__RDS_HOST__:3306/group_buy?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&sslMode=__RDS_SSL_MODE__&connectTimeout=5000&socketTimeout=30000&tcpKeepAlive=true
SPRING_DATASOURCE_USERNAME=group_buy_app
SPRING_DATASOURCE_PASSWORD=__RDS_PASSWORD__
MARKET_DB_MINIMUM_IDLE=2
MARKET_DB_MAXIMUM_POOL_SIZE=8
MARKET_DB_CONNECTION_TIMEOUT_MS=5000
MARKET_DB_VALIDATION_TIMEOUT_MS=3000
MARKET_DB_IDLE_TIMEOUT_MS=600000
MARKET_DB_KEEPALIVE_TIME_MS=300000
MARKET_DB_MAX_LIFETIME_MS=1500000

SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=ekko_app
SPRING_RABBITMQ_PASSWORD=__RABBITMQ_PASSWORD__
SPRING_RABBITMQ_VIRTUAL_HOST=/
RABBITMQ_LISTENER_CONCURRENCY=1
RABBITMQ_LISTENER_MAX_CONCURRENCY=2
RABBITMQ_LISTENER_PREFETCH=1

BUSINESS_EXECUTOR_CORE_POOL_SIZE=2
BUSINESS_EXECUTOR_MAX_POOL_SIZE=4
BUSINESS_EXECUTOR_KEEP_ALIVE_SECONDS=60
BUSINESS_EXECUTOR_QUEUE_CAPACITY=100
BUSINESS_EXECUTOR_REJECTION_POLICY=CallerRunsPolicy

MARKET_REDIS_HOST=redis
MARKET_REDIS_PORT=6379
MARKET_REDIS_PASSWORD=__REDIS_PASSWORD__
MARKET_REDIS_POOL_SIZE=6
MARKET_REDIS_MIN_IDLE_SIZE=1

MARKET_DCC_SYSTEM=ekko-group-buy-market
MARKET_DCC_REDIS_HOST=redis
MARKET_DCC_REDIS_PORT=6379
MARKET_DCC_REDIS_PASSWORD=__REDIS_PASSWORD__
MARKET_DCC_REDIS_POOL_SIZE=3
MARKET_DCC_REDIS_MIN_IDLE_SIZE=1

GROUP_BUY_NOTIFY_URL_WHITELIST=http://mall:8092/api/v1/alipay/group_buy_notify
GROUP_BUY_NOTIFY_TOKEN=__NOTIFY_TOKEN__
LOG_LEVEL_ROOT=info
