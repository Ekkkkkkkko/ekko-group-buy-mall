# 复制到服务器 /etc/ekko/mall.env，填入真实值后执行 chmod 600。
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8092
# 每个服务独占一台 2C4G 主机时的初始值。
JAVA_OPTS=-Xms768m -Xmx2048m -Xss512k -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/var/log/ekko/mall -XX:+ExitOnOutOfMemoryError -Xlog:gc*:file=/var/log/ekko/mall/gc.log:time,uptime,level,tags:filecount=5,filesize=20M

SERVER_TOMCAT_THREADS_MAX=100
SERVER_TOMCAT_THREADS_MIN_SPARE=10
SERVER_TOMCAT_MAX_CONNECTIONS=1000
SERVER_TOMCAT_ACCEPT_COUNT=100
SERVER_TOMCAT_CONNECTION_TIMEOUT=10s

# 先在 RDS 控制台开启 SSL；生产服务器使用同地域、同 VPC 的 RDS 内网地址。
SPRING_DATASOURCE_URL=jdbc:mysql://rm-xxxxxxxx.mysql.rds.aliyuncs.com:3306/group_buy_mall?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&sslMode=REQUIRED&connectTimeout=5000&socketTimeout=30000&tcpKeepAlive=true
SPRING_DATASOURCE_USERNAME=group_buy_mall
SPRING_DATASOURCE_PASSWORD=
MALL_DB_MINIMUM_IDLE=3
MALL_DB_MAXIMUM_POOL_SIZE=12
MALL_DB_CONNECTION_TIMEOUT_MS=5000
MALL_DB_VALIDATION_TIMEOUT_MS=3000
MALL_DB_IDLE_TIMEOUT_MS=600000
MALL_DB_KEEPALIVE_TIME_MS=300000
MALL_DB_MAX_LIFETIME_MS=1500000

SPRING_RABBITMQ_HOST=rabbitmq-host
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=group_buy_mall
SPRING_RABBITMQ_PASSWORD=
SPRING_RABBITMQ_VIRTUAL_HOST=/
RABBITMQ_LISTENER_CONCURRENCY=2
RABBITMQ_LISTENER_MAX_CONCURRENCY=4
RABBITMQ_REFUND_PREFETCH=1

BUSINESS_EXECUTOR_CORE_POOL_SIZE=2
BUSINESS_EXECUTOR_MAX_POOL_SIZE=4
BUSINESS_EXECUTOR_KEEP_ALIVE_SECONDS=60
BUSINESS_EXECUTOR_QUEUE_CAPACITY=100
BUSINESS_EXECUTOR_REJECTION_POLICY=CallerRunsPolicy

MALL_REDIS_HOST=redis-host
MALL_REDIS_PORT=6379
MALL_REDIS_PASSWORD=
MALL_REDIS_POOL_SIZE=8
MALL_REDIS_MIN_IDLE_SIZE=2

AUTH_JWT_SECRET=
GROUP_BUY_MARKET_API_URL=http://market-service:8091/
GROUP_BUY_MARKET_SOURCE=s01
GROUP_BUY_MARKET_CHANNEL=c01
GROUP_BUY_MARKET_NOTIFY_TYPE=HTTP
GROUP_BUY_MARKET_NOTIFY_URL=https://mall.example.com/api/v1/alipay/group_buy_notify
GROUP_BUY_MARKET_NOTIFY_MQ=
# 必须与 market.env 中的 GROUP_BUY_NOTIFY_TOKEN 完全一致。
GROUP_BUY_NOTIFY_TOKEN=

ALIPAY_ENABLED=true
ALIPAY_APP_ID=
# 当前代码需要 PKCS8 Base64 单行私钥，不要加入 PEM 头尾或换行。
ALIPAY_MERCHANT_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://api.example.com/api/v1/alipay/pay_notify
ALIPAY_RETURN_URL=https://www.example.com/
ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do

WEIXIN_CALLBACK_TOKEN=
WEIXIN_ORIGINAL_ID=
WEIXIN_APP_ID=
WEIXIN_APP_SECRET=
WEIXIN_TEMPLATE_ID=
