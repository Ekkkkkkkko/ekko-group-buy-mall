# 复制到服务器 /etc/ekko/chat.env，填入真实值后执行 chmod 600。
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8095

# 先在 RDS 控制台开启 SSL；生产服务器使用同地域、同 VPC 的 RDS 内网地址。
SPRING_DATASOURCE_URL=jdbc:mysql://rm-xxxxxxxx.mysql.rds.aliyuncs.com:3306/group_buy_chat?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&sslMode=REQUIRED&connectTimeout=5000&socketTimeout=30000&tcpKeepAlive=true
SPRING_DATASOURCE_USERNAME=group_buy_chat
SPRING_DATASOURCE_PASSWORD=
CHAT_DB_MINIMUM_IDLE=2
CHAT_DB_MAXIMUM_POOL_SIZE=10
CHAT_DB_CONNECTION_TIMEOUT_MS=5000
CHAT_DB_IDLE_TIMEOUT_MS=600000
CHAT_DB_KEEPALIVE_TIME_MS=300000
CHAT_DB_MAX_LIFETIME_MS=1500000

CHAT_REDIS_HOST=redis-host
CHAT_REDIS_PORT=6379
CHAT_REDIS_PASSWORD=
CHAT_REDIS_DATABASE=0
CHAT_REDISSON_ADDRESS=redis://redis-host:6379

CHAT_ALLOWED_ORIGINS=https://www.example.com

OSS_REGION=cn-shanghai
OSS_BUCKET=
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

MINERU_BASE_URL=https://mineru.net
MINERU_API_KEY=

ELASTICSEARCH_URL=http://elasticsearch-host:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX_NAME=group_chat_knowledge_chunk_v2_1536

MODEL_BASE_URL=
MODEL_API_KEY=
CHAT_MODEL=qwen3.5-flash
RAG_CHAT_MODEL=qwen3.6-plus
COMMON_CHAT_MODEL=qwen3.6-plus
TITLE_MODEL=qwen3.5-flash
MODEL_ENABLE_THINKING=false
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1536

XXL_JOB_ENABLED=false
XXL_JOB_ADMIN_ADDRESSES=http://xxl-job-admin:8080/xxl-job-admin
XXL_JOB_ACCESS_TOKEN=
