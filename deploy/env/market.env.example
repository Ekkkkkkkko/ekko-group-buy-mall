# 复制到服务器 /etc/ekko/market.env，填入真实值后执行 chmod 600。
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8091
# 每个服务独占一台 2C4G 主机时的初始值。
JAVA_OPTS=-Xms768m -Xmx2048m -Xss512k -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/var/log/ekko/market -XX:+ExitOnOutOfMemoryError -Xlog:gc*:file=/var/log/ekko/market/gc.log:time,uptime,level,tags:filecount=5,filesize=20M

SERVER_TOMCAT_THREADS_MAX=100
SERVER_TOMCAT_THREADS_MIN_SPARE=10
SERVER_TOMCAT_MAX_CONNECTIONS=1000
SERVER_TOMCAT_ACCEPT_COUNT=100
SERVER_TOMCAT_CONNECTION_TIMEOUT=10s

# 先在 RDS 控制台开启 SSL；生产服务器使用同地域、同 VPC 的 RDS 内网地址。
SPRING_DATASOURCE_URL=jdbc:mysql://rm-xxxxxxxx.mysql.rds.aliyuncs.com:3306/group_buy?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&sslMode=REQUIRED&connectTimeout=5000&socketTimeout=30000&tcpKeepAlive=true
SPRING_DATASOURCE_USERNAME=group_buy_app
SPRING_DATASOURCE_PASSWORD=
MARKET_DB_MINIMUM_IDLE=3
MARKET_DB_MAXIMUM_POOL_SIZE=12
MARKET_DB_CONNECTION_TIMEOUT_MS=5000
MARKET_DB_VALIDATION_TIMEOUT_MS=3000
MARKET_DB_IDLE_TIMEOUT_MS=600000
MARKET_DB_KEEPALIVE_TIME_MS=300000
MARKET_DB_MAX_LIFETIME_MS=1500000

SPRING_RABBITMQ_HOST=rabbitmq-host
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=group_buy_market
SPRING_RABBITMQ_PASSWORD=
SPRING_RABBITMQ_VIRTUAL_HOST=/
RABBITMQ_LISTENER_CONCURRENCY=2
RABBITMQ_LISTENER_MAX_CONCURRENCY=4
RABBITMQ_LISTENER_PREFETCH=1

BUSINESS_EXECUTOR_CORE_POOL_SIZE=4
BUSINESS_EXECUTOR_MAX_POOL_SIZE=8
BUSINESS_EXECUTOR_KEEP_ALIVE_SECONDS=60
BUSINESS_EXECUTOR_QUEUE_CAPACITY=200
BUSINESS_EXECUTOR_REJECTION_POLICY=CallerRunsPolicy

MARKET_REDIS_HOST=redis-host
MARKET_REDIS_PORT=6379
MARKET_REDIS_PASSWORD=
MARKET_REDIS_POOL_SIZE=8
MARKET_REDIS_MIN_IDLE_SIZE=2

MARKET_DCC_SYSTEM=ekko-group-buy-market
MARKET_DCC_REDIS_HOST=dcc-redis-host
MARKET_DCC_REDIS_PORT=6379
MARKET_DCC_REDIS_PASSWORD=
MARKET_DCC_REDIS_POOL_SIZE=4
MARKET_DCC_REDIS_MIN_IDLE_SIZE=1

GROUP_BUY_NOTIFY_URL_WHITELIST=https://mall.example.com/api/v1/alipay/group_buy_notify
# 必须与 mall.env 中的 GROUP_BUY_NOTIFY_TOKEN 完全一致，建议使用 openssl rand -base64 48 生成。
GROUP_BUY_NOTIFY_TOKEN=
