<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.ekko.infrastructure.dao.IProductDao">

    <resultMap id="dataMap" type="cn.ekko.infrastructure.dao.po.Product">
        <id column="id" property="id"/>
        <result column="product_id" property="productId"/>
        <result column="product_name" property="productName"/>
        <result column="product_desc" property="productDesc"/>
        <result column="product_model" property="productModel"/>
        <result column="product_specs" property="productSpecs"/>
        <result column="base_price" property="basePrice"/>
        <result column="image_url" property="imageUrl"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="queryAvailableProductList" resultMap="dataMap">
        select id, product_id, product_name, product_desc, product_model,
               product_specs, base_price, image_url, status, create_time, update_time
        from product
        where status = 1
        order by id asc
    </select>

    <select id="queryAvailableProductByProductId" parameterType="java.lang.String" resultMap="dataMap">
        select id, product_id, product_name, product_desc, product_model,
               product_specs, base_price, image_url, status, create_time, update_time
        from product
        where product_id = #{productId}
          and status = 1
        limit 1
    </select>

</mapper>
